{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(~/.ssh/config)",
      "Read(//tmp/**)",
      "Edit(//tmp/**)",
      "Bash(task --list*)",
      "Bash(task clean*)",
      "Bash(task test*)",
      "Bash(task build*)",
      "Bash(tofu init)",
      "Bash(tofu init -upgrade)",
      "Bash(tofu init -input=false)",
      "Bash(tofu plan)",
      "Bash(tofu plan -input=false)",
      "Bash(tofu plan -refresh=false)",
      "Bash(gh auth status*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr status*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh repo list*)",
      "Bash(gh repo view*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh search *)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(gh label list*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Edit(~/.ssh/config)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune*)",
      "Bash(gh api *)",
      "Bash(gh auth login *)",
      "Bash(gh auth logout *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue delete *)",
      "Bash(gh repo create *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo rename *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh release delete *)",
      "Bash(gh release upload *)",
      "Bash(gh run cancel *)",
      "Bash(gh run rerun *)",
      "Bash(gh run delete *)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh label create *)",
      "Bash(gh label edit *)",
      "Bash(gh label delete *)",
      "Bash(gh secret set *)",
      "Bash(gh secret delete *)",
      "Bash(gh variable set *)",
      "Bash(gh variable delete *)",
      "Bash(kubectl *)",
      "Bash(snip kubectl *)",
      "Bash(tofu apply)",
      "Bash(tofu apply *)",
      "Bash(tofu destroy)",
      "Bash(tofu destroy *)",
      "Bash(tofu import)",
      "Bash(tofu import *)",
      "Bash(tofu state)",
      "Bash(tofu state *)",
      "Bash(tofu workspace)",
      "Bash(tofu workspace *)",
      "Bash(tofu force-unlock)",
      "Bash(tofu force-unlock *)",
      "Bash(tofu init *-backend-config*)",
      "Bash(tofu init *--backend-config*)",
      "Bash(tofu init *-reconfigure*)",
      "Bash(tofu init *--reconfigure*)",
      "Bash(tofu init *-migrate-state*)",
      "Bash(tofu init *--migrate-state*)",
      "Bash(tofu plan *-generate-config-out*)"
    ],
    "additionalDirectories": [
      "/tmp",
      "/Users/matt/.worktrees"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/snip-hook.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/matt/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "effortLevel": "medium",
  "agent": "supervisor",
  "theme": "dark-ansi",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
