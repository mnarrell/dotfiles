{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(~/.ssh/config)",
      "Read(//tmp/**)",
      "Edit(//tmp/**)",
      "Bash(snip rg *)",
      "Bash(snip wc *)",
      "Bash(snip ls)",
      "Bash(snip ls *)",
      "Bash(snip tree)",
      "Bash(snip tree *)",
      "Bash(snip stat *)",
      "Bash(snip diff *)",
      "Bash(snip fd *)",
      "Bash(snip cat *)",
      "Bash(snip head *)",
      "Bash(snip tail *)",
      "Bash(snip which *)",
      "Bash(snip date)",
      "Bash(snip date *)",
      "Bash(snip sort)",
      "Bash(snip grep *)",
      "Bash(snip sed *)",
      "Bash(snip awk *)",
      "Bash(snip cut *)",
      "Bash(snip echo *)",
      "Bash(snip sort *)",
      "Bash(snip git status*)",
      "Bash(snip git diff*)",
      "Bash(snip git log*)",
      "Bash(snip git show*)",
      "Bash(snip git branch)",
      "Bash(snip git branch -a)",
      "Bash(snip git branch -v*)",
      "Bash(snip git branch --show-current)",
      "Bash(snip git branch --merged *)",
      "Bash(snip git branch --no-merged *)",
      "Bash(snip git worktree list*)",
      "Bash(snip git remote -v)",
      "Bash(snip git ls-remote *)",
      "Bash(snip git merge-base *)",
      "Bash(snip git fetch origin main)",
      "Bash(snip git rev-parse *)",
      "Bash(snip git rev-list *)",
      "Bash(snip git for-each-ref *)",
      "Bash(snip git ls-files *)",
      "Bash(snip git config --get*)",
      "Bash(snip gh pr list*)",
      "Bash(snip gh pr view*)",
      "Bash(snip gh pr checks*)",
      "Bash(snip gh pr diff*)",
      "Bash(snip gh issue list*)",
      "Bash(snip gh issue view*)",
      "Bash(snip gh repo list*)",
      "Bash(snip gh repo view*)",
      "Bash(snip gh run list*)",
      "Bash(snip gh run view*)",
      "Bash(snip gh auth status*)",
      "Bash(snip gh release list*)",
      "Bash(snip gh release view*)",
      "Bash(snip gh search *)",
      "Bash(snip gh workflow list*)",
      "Bash(snip gh workflow view*)",
      "Bash(snip gh label list*)",
      "Bash(snip task --list*)",
      "Bash(snip task clean*)",
      "Bash(snip task test*)",
      "Bash(snip task build*)",
      "Bash(snip kubectl get *)",
      "Bash(snip kubectl diff *)",
      "Bash(snip kubectl version *)",
      "Bash(snip kubectl api-resources *)",
      "Bash(snip helmfile * template *)",
      "WebSearch"
    ],
    "deny": [
      "Edit(~/.ssh/config)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune*)",
      "Bash(gh api *)",
      "Bash(gh pr merge *)"
    ],
    "additionalDirectories": [
      "/tmp",
      "/Users/matt/.worktrees"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "snip hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/matt/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "effortLevel": "medium",
  "agent": "supervisor",
  "theme": "dark-ansi",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
