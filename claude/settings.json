{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "supervisor",
  "permissions": {
    "additionalDirectories": ["/tmp"],
    "allow": [
      "Read(~/.ssh/config)",
      "Read(//tmp/**)",
      "Edit(//tmp/**)",

      "Bash(snip rg *)",
      "Bash(snip wc *)",
      "Bash(snip ls)",
      "Bash(snip ls *)",
      "Bash(snip tree)",
      "Bash(snip tree *)",
      "Bash(snip stat *)",
      "Bash(snip diff *)",

      "Bash(snip git status*)",
      "Bash(snip git diff*)",
      "Bash(snip git log*)",
      "Bash(snip git show*)",
      "Bash(snip git branch)",
      "Bash(snip git branch -a)",
      "Bash(snip git branch -v*)",
      "Bash(snip git branch --show-current)",
      "Bash(snip git branch --merged *)",
      "Bash(snip git branch --no-merged *)",
      "Bash(snip git worktree list*)",
      "Bash(snip git remote -v)",
      "Bash(snip git ls-remote *)",
      "Bash(snip git merge-base *)",
      "Bash(snip git fetch origin main)",

      "Bash(snip gh pr list*)",
      "Bash(snip gh pr view*)",
      "Bash(snip gh pr checks*)",
      "Bash(snip gh pr diff*)",
      "Bash(snip gh issue list*)",
      "Bash(snip gh issue view*)",
      "Bash(snip gh repo list*)",
      "Bash(snip gh repo view*)",
      "Bash(snip gh run list*)",
      "Bash(snip gh run view*)",

      "Bash(snip task --list*)",
      "Bash(snip kubectl get *)",
      "Bash(snip kubectl diff *)",
      "Bash(snip kubectl version *)",
      "Bash(snip kubectl api-resources *)",

      "Bash(fd *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(which *)",
      "Bash(date)",
      "Bash(date *)",
      "Bash(sort)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(cut *)",
      "Bash(echo *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(gh auth status*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh repo list*)",
      "Bash(gh repo view*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh search *)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(gh label list*)",

      "Bash(task --list*)",
      "Bash(kubectl get *)",
      "Bash(kubectl diff *)",
      "Bash(kubectl version *)",
      "Bash(kubectl api-resources *)",
      "Bash(helmfile * template *)",
      "WebSearch"
    ],
    "deny": ["Edit(~/.ssh/config)"],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune*)",
      "Bash(gh api *)",
      "Bash(gh pr merge *)"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "effortLevel": "high",
  "theme": "dark",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
