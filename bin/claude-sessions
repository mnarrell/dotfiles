#!/usr/bin/env bash
#
# claude-sessions - browse, resume, and delete Claude Code CLI sessions
# across all projects, fzf-picker style like the native `/resume`.
#
# Claude Code's own `/resume` picker already handles browsing, resuming
# (Enter), and renaming (Ctrl+R) - this script does not reimplement rename.
# It exists to fill the one real gap: deleting a single session.
# `claude project purge <path>` only wipes an entire project's history, not
# one session.
#
# Session storage layout (Claude Code 2.1.x):
#   ~/.claude/projects/<encoded-cwd>/<sessionId>.jsonl   - the session
#   ~/.claude/projects/<encoded-cwd>/<sessionId>/        - sidecar dir
#       (subagents/*.jsonl, tool-results/*) belonging to that session
#   ~/.claude/sessions/*.json                            - live registry of
#       currently-running sessions (pid, sessionId, cwd, status, ...)
#
# Title resolution priority (JSONL records inside the session file):
#   {"type":"custom-title","customTitle":"..."}  - set via native Ctrl+R rename
#   {"type":"ai-title","aiTitle":"..."}           - auto-generated title
#   first {"type":"user",...} message text        - fallback preview
#   sessionId                                      - last resort
#
# Requires GNU coreutils (already a Brewfile dependency in this repo).

set -Eeuo pipefail
trap cleanup SIGINT SIGTERM ERR EXIT
cleanup() { trap - SIGINT SIGTERM ERR EXIT; }

NOFORMAT=$'\033[0m'
YELLOW=$'\033[1;33m'
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'

PROJECTS_DIR="${HOME}/.claude/projects"
LIVE_SESSIONS_DIR="${HOME}/.claude/sessions"

usage() {
  cat <<'EOF'
Usage: claude-sessions [--list] [--delete <sessionId>] [-h|--help]

Browse, resume, and delete Claude Code CLI sessions across all projects.

With no options, launches an interactive fzf picker (like `/resume`, plus
delete):
  Enter    resume the highlighted session (cd + `claude --resume <id>`)
  ctrl-d   delete the highlighted session (confirmation required; refused
           for sessions that are currently running)
  (rename a session from inside `claude --resume` / `/resume` itself,
   with Ctrl+R - this tool does not reimplement that)

Options:
  --list                 print all sessions as a table and exit (no fzf)
  --delete <sessionId>   delete one session non-interactively (same
                         confirmation and running-session guard)
  -h, --help             show this help
EOF
}

# One TSV line per session: id, project, title, age, size, running, pid, jsonlPath
enumerate_sessions() {
  local jsonl project title cwd running pid mtime size sid now livefile
  now=$(date +%s)

  for jsonl in "${PROJECTS_DIR}"/*/*.jsonl; do
    [[ -e "$jsonl" ]] || continue
    sid=$(basename "$jsonl" .jsonl)

    cwd=$( (grep -m1 -o '"cwd":"[^"]*"' "$jsonl" || true) | sed -E 's/"cwd":"(.*)"/\1/')
    [[ -z "$cwd" ]] && cwd=$(sed 's#-#/#g' <<< "$(basename "$(dirname "$jsonl")")")
    project="$cwd"

    title=$( (grep -m1 -o '"type":"custom-title","customTitle":"[^"]*"' "$jsonl" || true) \
      | sed -E 's/.*"customTitle":"(.*)"/\1/')
    [[ -z "$title" ]] && title=$( (grep -m1 -o '"type":"ai-title","aiTitle":"[^"]*"' "$jsonl" || true) \
      | sed -E 's/.*"aiTitle":"(.*)"/\1/')
    [[ -z "$title" ]] && title=$( (grep -m1 '"type":"user"' "$jsonl" || true) \
      | { grep -o '"text":"[^"]*"' || true; } | head -1 | sed -E 's/"text":"(.*)"/\1/' | cut -c1-60)
    [[ -z "$title" ]] && title="$sid"

    mtime=$(stat -c '%Y' "$jsonl")
    size=$(du -h "$jsonl" | awk '{print $1}')

    running=0; pid=""
    for livefile in "${LIVE_SESSIONS_DIR}"/*.json; do
      [[ -e "$livefile" ]] || continue
      if grep -q "\"sessionId\":\"${sid}\"" "$livefile" 2>/dev/null; then
        running=1
        pid=$(grep -o '"pid":[0-9]*' "$livefile" | head -1 | cut -d: -f2)
        break
      fi
    done

    local age=$(( now - mtime )) age_h
    if   (( age < 3600 ));  then age_h="$(( age / 60 ))m"
    elif (( age < 86400 )); then age_h="$(( age / 3600 ))h"
    else                         age_h="$(( age / 86400 ))d"
    fi

    # NOTE: $project is the *full* path here, deliberately - resume needs it
    # to cd into. Renderers below derive the basename for display themselves.
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$sid" "$project" "$title" "$age_h" "$size" "$running" "$pid" "$jsonl"
  done
}

render_table() {
  { printf 'SESSION_ID\tPROJECT\tTITLE\tAGE\tSIZE\tSTATUS\n'
    enumerate_sessions | awk -F'\t' 'BEGIN{OFS="\t"} {
      n = split($2, parts, "/"); proj = parts[n]
      status = ($6=="1") ? "[running pid " $7 "]" : "-"
      print $1, proj, $3, $4, $5, status
    }'
  } | column -t -s $'\t'
}

# fzf-facing rows: col1 = session id (hidden via --with-nth), col2 = one
# pre-padded display string. Reuses enumerate_sessions - no duplicate logic.
render_rows() {
  enumerate_sessions | awk -F'\t' 'BEGIN{OFS="\t"} {
    n = split($2, parts, "/"); proj = parts[n]
    status = ($6=="1") ? "[running pid " $7 "]" : ""
    printf "%s\t%-9.9s  %-50.50s  %-4s  %-6s  %s\n", $1, proj, $3, $4, $5, status
  }'
}

resume_session() {
  local sid=$1 project=$2
  if [[ ! -d "$project" ]]; then
    printf "%sProject directory no longer exists: %s%s\n" "$RED" "$project" "$NOFORMAT" >&2
    exit 1
  fi
  cd "$project"
  exec claude --resume "$sid"
}

interactive_picker() {
  command -v fzf >/dev/null 2>&1 || {
    printf "%sfzf is required for the interactive picker. Use --list/--delete instead, or install fzf.%s\n" \
      "$RED" "$NOFORMAT" >&2
    exit 1
  }

  local self="${BASH_SOURCE[0]}"
  local selection
  selection=$(render_rows | fzf \
    --delimiter='\t' --with-nth=2 \
    --header 'Enter: resume   ctrl-d: delete   (rename: Ctrl+R inside claude --resume)' \
    --bind "ctrl-d:execute(${self} --delete {1})+reload(${self} --rows)" \
    || true)
  [[ -z "$selection" ]] && return 0

  local sid project line
  sid=$(cut -f1 <<< "$selection")
  line=$(enumerate_sessions | awk -F'\t' -v id="$sid" '$1==id')
  project=$(cut -f2 <<< "$line")
  resume_session "$sid" "$project"
}

delete_session() {
  local sid=$1 line
  line=$(enumerate_sessions | awk -F'\t' -v id="$sid" '$1==id')
  [[ -z "$line" ]] && { printf "%sNo session found with id %s%s\n" "$RED" "$sid" "$NOFORMAT" >&2; return 1; }

  # NOTE: deliberately not using `read -d $'\t'` here - bash's `read` treats
  # tab as "IFS whitespace" and collapses consecutive delimiters, which
  # silently drops the empty `pid` field (when a session isn't running) and
  # shifts every field after it. `cut -f` does not have that problem.
  project=$(cut -f2 <<< "$line")
  title=$(cut -f3 <<< "$line")
  running=$(cut -f6 <<< "$line")
  pid=$(cut -f7 <<< "$line")
  jsonl=$(cut -f8 <<< "$line")

  if [[ "$running" == "1" ]]; then
    printf "%sRefusing to delete: session %s is currently running (pid %s). Exit it first.%s\n" \
      "$RED" "$sid" "$pid" "$NOFORMAT" >&2
    return 1
  fi

  local sidecar_dir="$(dirname "$jsonl")/${sid}"
  printf "%sWill delete:%s\n  session: %s (%s)\n  project: %s\n  file:    %s\n" \
    "$YELLOW" "$NOFORMAT" "$sid" "$title" "$project" "$jsonl"
  [[ -d "$sidecar_dir" ]] && printf "  dir:     %s\n" "$sidecar_dir"

  # Explicit /dev/tty so the confirmation still works when this function is
  # invoked from fzf's `execute()` binding, not just a plain interactive shell.
  local reply
  read -r -p "Type 'y' to confirm deletion: " reply < /dev/tty
  [[ "$reply" != "y" ]] && { printf "%sAborted.%s\n" "$YELLOW" "$NOFORMAT"; return 1; }

  rm -f -- "$jsonl"
  [[ -d "$sidecar_dir" ]] && rm -rf -- "$sidecar_dir"
  printf "%sDeleted session %s.%s\n" "$GREEN" "$sid" "$NOFORMAT"
}

main() {
  [[ -d "$PROJECTS_DIR" ]] || { printf "%sNo Claude Code project data found.%s\n" "$RED" "$NOFORMAT" >&2; exit 1; }

  case "${1:-}" in
    --list)    render_table ;;
    --rows)    render_rows ;;  # internal: raw TSV feed for fzf's own reload
    --delete)  [[ -n "${2:-}" ]] || { printf "%s--delete requires a session id%s\n" "$RED" "$NOFORMAT" >&2; exit 1; }
               delete_session "$2" ;;
    -h|--help) usage ;;
    "")        interactive_picker ;;
    *)         printf "%sUnknown argument: %s%s\n" "$RED" "$1" "$NOFORMAT" >&2; usage; exit 1 ;;
  esac
}

main "$@"
