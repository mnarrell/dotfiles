#! /usr/bin/env bash
#
# Build one terminal-notifier copy per agent harness, each with that agent's
# icon, so notifications show which agent is calling at a glance.
#
#   agent-notifier-build [--force]
#
# macOS takes a notification's icon from the bundle that sent it and offers
# no per-notification override (terminal-notifier 3 dropped -appIcon), so
# each icon needs its own bundle with its own identifier. Built into
# $XDG_DATA_HOME/tmux-agents/<harness>-notifier.app; agent-notify uses one
# when it exists and falls back to plain terminal-notifier otherwise.
#
# Icons: Claude and OpenCode come from their installed apps; pi has no logo
# on disk, so it gets a drawn one. Each new bundle appears separately in
# System Settings > Notifications and asks for permission once; this script
# sends one notification from each to trigger that prompt.
#
# Run by `task tmux:up`, so re-runs are cheap and quiet: an existing bundle
# is kept (rebuilding would raise its permission prompt again) unless
# --force, and an agent whose app is not installed is skipped.

set -eu

force=""
[ "${1:-}" = "--force" ] && force=1

command -v terminal-notifier >/dev/null 2>&1 || exit 0
src="$(brew --prefix terminal-notifier)/terminal-notifier.app"
out="${XDG_DATA_HOME:-$HOME/.local/share}/tmux-agents"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

mkdir -p "$out"

# icns <png> <dest.icns>: build a multi-resolution icon from a large PNG.
# shellcheck disable=SC2329 # called from pi_icon
icns() {
	local set="$work/icon.iconset" size
	rm -rf "$set"
	mkdir "$set"
	for size in 16 32 128 256 512; do
		sips -z "$size" "$size" "$1" --out "$set/icon_${size}x${size}.png" >/dev/null
		sips -z $((size * 2)) $((size * 2)) "$1" --out "$set/icon_${size}x${size}@2x.png" >/dev/null
	done
	iconutil -c icns "$set" -o "$2"
}

# shellcheck disable=SC2329 # called indirectly, as an argument to build
pi_icon() {
	cat >"$work/pi.svg" <<-'SVG'
		<svg xmlns="http://www.w3.org/2000/svg" width="1024" height="1024" viewBox="0 0 1024 1024">
		  <rect x="64" y="64" width="896" height="896" rx="200" fill="#1d1f21"/>
		  <text x="512" y="700" text-anchor="middle" font-family="Menlo, monospace"
		        font-size="620" font-weight="bold" fill="#f0c674">π</text>
		</svg>
	SVG
	qlmanage -t -s 1024 -o "$work" "$work/pi.svg" >/dev/null 2>&1
	icns "$work/pi.svg.png" "$1"
}

# build <harness> <display name> <icns-producing command...>
build() {
	local harness="$1" name="$2" app="$out/$1-notifier.app"
	shift 2
	[ -n "$force" ] || [ ! -d "$app" ] || return 0
	rm -rf "$app"
	cp -R "$src" "$app"
	chmod -R u+w "$app"
	"$@" "$app/Contents/Resources/Terminal.icns"

	local plist="$app/Contents/Info.plist"
	/usr/libexec/PlistBuddy \
		-c "Set :CFBundleIdentifier fr.julienxx.oss.terminal-notifier.tmux-$harness" \
		-c "Set :CFBundleName $name" \
		"$plist"
	/usr/libexec/PlistBuddy -c "Add :CFBundleDisplayName string $name" "$plist" 2>/dev/null ||
		/usr/libexec/PlistBuddy -c "Set :CFBundleDisplayName $name" "$plist"

	codesign --force --deep --sign - "$app" >/dev/null 2>&1
	/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"

	# A first notification sent through LaunchServices raises the permission prompt.
	open -W -n "$app" --args -title "$name" -message "Agent notifications are set up" -group "tmux-agents-setup-$harness"
	echo "built $app"
}

claude_icon=/Applications/Claude.app/Contents/Resources/electron.icns
opencode_icon=/Applications/OpenCode.app/Contents/Resources/icon.icns
[ -f "$claude_icon" ] && build claude "Claude (tmux)" cp "$claude_icon"
[ -f "$opencode_icon" ] && build opencode "OpenCode (tmux)" cp "$opencode_icon"
command -v pi >/dev/null 2>&1 && build pi "pi (tmux)" pi_icon
exit 0
