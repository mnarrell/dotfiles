{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "supervisor",
  "agent": {
    "plan": {
      "model": "opencode/big-pickle",
    },
    "build": {
      "model": "opencode/big-pickle",
    },
  },

  // This repository manages the XDG configuration and data locations below.
  // Narrow sensitive-directory overrides must follow the broad allows.
  "permission": {
    "read": {
      "~/.dotfiles/**": "allow",
      "~/.config/**": "allow",
      "~/.local/bin/**": "allow",
      "~/.local/share/**": "allow",
      "~/.local/state/**": "allow",
      "~/.cache/**": "allow",
      "~/tmp/xdg_runtime/**": "allow",
      "~/.claude/**": "allow",
      "~/.terminfo/**": "allow",

      "~/.config/op/**": "deny",
      "~/.config/comcast/**": "ask",
    },
    "edit": {
      "~/.dotfiles/**": "allow",
      "~/.config/**": "allow",
      "~/.local/bin/**": "allow",
      "~/.local/share/**": "allow",
      "~/.local/state/**": "allow",
      "~/.cache/**": "allow",
      "~/tmp/xdg_runtime/**": "allow",
      "~/.claude/**": "allow",
      "~/.terminfo/**": "allow",

      "~/.config/op/**": "deny",
      "~/.config/comcast/**": "ask",
    },
    "external_directory": {
      "*": "ask",
      "~/.dotfiles/**": "allow",
      "~/.worktrees/**": "allow",
      "/Users/matt/.worktrees/**": "allow",
      "~/.config/**": "allow",
      "~/.local/bin/**": "allow",
      "~/.local/share/**": "allow",
      "~/.local/state/**": "allow",
      "~/.cache/**": "allow",
      "~/tmp/xdg_runtime/**": "allow",
      "~/.claude/**": "allow",
      "~/.terminfo/**": "allow",

      "~/.config/op/**": "deny",
      "~/.config/comcast/**": "ask",
    },
  },
}
