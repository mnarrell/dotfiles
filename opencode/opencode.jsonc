{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,

  // DCP (Dynamic Context Pruning): surgical mid-session context management.
  // Configured via dcp.jsonc. Prefer this over OpenCode's built-in compaction.
  "plugin": [
    // renovate: datasource=npm depName=@tarquinen/opencode-dcp
    "@tarquinen/opencode-dcp@3.1.15",
    // renovate: datasource=npm depName=opencode-snip
    "opencode-snip@1.6.1",
  ],

  // Default model for all conversations
  "model": "openai/gpt-5.6-terra",

  // Lightweight model for background tasks (title generation, etc.)
  "small_model": "openai/gpt-5.6-luna",

  // Use the orchestrator by default. Switch to Worker for simple direct edits.
  "default_agent": "supervisor",

  // Supervisor -> Worker -> Researcher requires two levels of bounded delegation.
  "subagent_depth": 2,

  "agent": {
    "build": { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true },
    "scout": { "disable": true },

    // Per-agent model overrides for custom agents
    "supervisor": { "model": "openai/gpt-5.6-terra" },
    "worker": { "model": "openai/gpt-5.6-terra" },
    "design": { "model": "openai/gpt-5.6-sol" },
    "researcher": { "model": "openai/gpt-5.6-luna" },
  },

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (mini)",
      "options": {
        "baseURL": "http://mini:11434/v1",
      },
      "models": {
        "qwen2.5:14b": { "name": "Qwen 2.5 14B" },
        "qwen2.5-coder:14b": { "name": "Qwen 2.5 Coder 14B" },
        "qwen3:14b": { "name": "Qwen 3 14B" },
        "gemma3:12b": { "name": "Gemma 3 12B" },
      },
    },
  },

  "permission": {
    "webfetch": "allow",
    "websearch": "allow",
    "read": {
      "~/.ssh/config": "allow",
      "/tmp/opencode": "allow",
      "/tmp/opencode/**": "allow",
    },
    "edit": {
      "~/.ssh/config": "deny",
      "/tmp/opencode": "allow",
      "/tmp/opencode/**": "allow",
    },
    "external_directory": {
      "*": "ask",
      "/tmp/opencode": "allow",
      "/tmp/opencode/**": "allow",
      "~/.worktrees/**": "allow",
      "~/.ssh/config": "allow",
      "~/src/**": "allow",
      "~/.private_dotfiles/**": "allow",
      "~/.local/share/mise/**": "allow",
      "~/tmp/xdg_runtime/**": "allow",
    },
    "bash": {
      "*": "ask",
      "go build*": "deny",
      "go test*": "deny",
      "snip go build*": "deny",
      "snip go test*": "deny",
    },
  },
}
