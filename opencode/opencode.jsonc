{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,

  // DCP (Dynamic Context Pruning): surgical mid-session context management.
  // Configured via dcp.jsonc. Prefer this over OpenCode's built-in compaction.
  "plugin": ["@tarquinen/opencode-dcp"],

  "default_agent": "supervisor",
  "agent": {
    "plan": {
      "model": "opencode/big-pickle",
    },
    "build": {
      "model": "opencode/big-pickle",
    },
  },

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (mini)",
      "options": {
        "baseURL": "http://mini:11434/v1",
      },
      "models": {
        "qwen2.5:14b": { "name": "Qwen 2.5 14B" },
        "qwen2.5-coder:14b": { "name": "Qwen 2.5 Coder 14B" },
        "qwen3:14b": { "name": "Qwen 3 14B" },
        "gemma3:12b": { "name": "Gemma 3 12B" },
      },
    },
  },

  "permission": {
    "read": {
      "~/.ssh/config": "allow",
      "/tmp/**": "allow",
    },
    "edit": {
      "~/.ssh/config": "deny",
      "/tmp/**": "allow",
    },
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "~/.worktrees/**": "allow",
      "~/.ssh/config": "allow",
    },
    "bash": {
      "*": "ask",

      "snip rg *": "allow",
      "snip wc *": "allow",
      "snip ls": "allow",
      "snip ls *": "allow",
      "snip tree": "allow",
      "snip tree *": "allow",
      "snip stat *": "allow",
      "snip diff *": "allow",
      "snip fd *": "allow",
      "snip cat *": "allow",
      "snip head *": "allow",
      "snip tail *": "allow",
      "snip which *": "allow",
      "snip date": "allow",
      "snip date *": "allow",
      "snip sort": "allow",
      "snip grep *": "allow",
      "snip sed *": "allow",
      "snip awk *": "allow",
      "snip cut *": "allow",
      "snip echo *": "allow",
      "snip sort *": "allow",

      "snip git status*": "allow",
      "snip git diff*": "allow",
      "snip git log*": "allow",
      "snip git show*": "allow",
      "snip git branch": "allow",
      "snip git branch -a": "allow",
      "snip git branch -v*": "allow",
      "snip git branch --show-current": "allow",
      "snip git branch --merged *": "allow",
      "snip git branch --no-merged *": "allow",
      "snip git worktree list*": "allow",
      "snip git remote -v": "allow",
      "snip git ls-remote *": "allow",
      "snip git merge-base *": "allow",
      "snip git fetch origin main": "allow",
      "snip git rev-parse *": "allow",
      "snip git rev-list *": "allow",
      "snip git for-each-ref *": "allow",
      "snip git ls-files *": "allow",
      "snip git config --get*": "allow",

      "snip gh pr list*": "allow",
      "snip gh pr view*": "allow",
      "snip gh pr checks*": "allow",
      "snip gh pr diff*": "allow",
      "snip gh issue list*": "allow",
      "snip gh issue view*": "allow",
      "snip gh repo list*": "allow",
      "snip gh repo view*": "allow",
      "snip gh run list*": "allow",
      "snip gh run view*": "allow",
      "snip gh auth status*": "allow",
      "snip gh release list*": "allow",
      "snip gh release view*": "allow",
      "snip gh search *": "allow",
      "snip gh workflow list*": "allow",
      "snip gh workflow view*": "allow",
      "snip gh label list*": "allow",

      "snip task --list*": "allow",
      "snip task clean*": "allow",
      "snip task test*": "allow",
      "snip task build*": "allow",
      "snip kubectl get *": "allow",
      "snip kubectl diff *": "allow",
      "snip kubectl version *": "allow",
      "snip kubectl api-resources *": "allow",
      "snip helmfile * template *": "allow",

    },
  },
}
