{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,

  // DCP (Dynamic Context Pruning): surgical mid-session context management.
  // Configured via dcp.jsonc. Prefer this over OpenCode's built-in compaction.
  "plugin": [
    // renovate: datasource=npm depName=@tarquinen/opencode-dcp
    "@tarquinen/opencode-dcp@3.1.15",
    // renovate: datasource=npm depName=opencode-snip
    "opencode-snip@1.6.1",
  ],

  "default_agent": "supervisor",
  "agent": {
    "plan": {
      "model": "opencode/big-pickle",
    },
    "build": {
      "model": "opencode/big-pickle",
    },
  },

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (mini)",
      "options": {
        "baseURL": "http://mini:11434/v1",
      },
      "models": {
        "qwen2.5:14b": { "name": "Qwen 2.5 14B" },
        "qwen2.5-coder:14b": { "name": "Qwen 2.5 Coder 14B" },
        "qwen3:14b": { "name": "Qwen 3 14B" },
        "gemma3:12b": { "name": "Gemma 3 12B" },
      },
    },
  },

  "permission": {
    "webfetch": "allow",
    "websearch": "allow",
    "read": {
      "~/.ssh/config": "allow",
      "/tmp/**": "allow",
    },
    "edit": {
      "~/.ssh/config": "deny",
      "/tmp/**": "allow",
    },
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "~/.worktrees/**": "allow",
      "~/.ssh/config": "allow",
      "~/src/**": "allow",
      "~/.private_dotfiles/**": "allow",
      "~/.local/share/mise/**": "allow",
      "~/tmp/xdg_runtime/**": "allow",
    },
    "bash": {
      "*": "ask",

      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "wc *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "stat *": "allow",
      "diff *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "which *": "allow",
      "date": "allow",
      "date *": "allow",
      "grep *": "allow",
      "cut *": "allow",

      "snip pwd": "allow",
      "snip ls": "allow",
      "snip ls *": "allow",
      "snip rg *": "allow",
      "snip wc *": "allow",
      "snip tree": "allow",
      "snip tree *": "allow",
      "snip stat *": "allow",
      "snip diff *": "allow",
      "snip cat *": "allow",
      "snip head *": "allow",
      "snip tail *": "allow",
      "snip which *": "allow",
      "snip date": "allow",
      "snip date *": "allow",
      "snip grep *": "allow",
      "snip cut *": "allow",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch": "allow",
      "git branch -a": "allow",
      "git branch -v*": "allow",
      "git branch --show-current": "allow",
      "git branch --merged *": "allow",
      "git branch --no-merged *": "allow",
      "git worktree list*": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git ls-remote *": "allow",
      "git merge-base *": "allow",
      "git rev-parse *": "allow",
      "git rev-list *": "allow",
      "git for-each-ref *": "allow",
      "git ls-files *": "allow",
      "git config --get*": "allow",

      "snip git status*": "allow",
      "snip git diff*": "allow",
      "snip git log*": "allow",
      "snip git show*": "allow",
      "snip git branch": "allow",
      "snip git branch -a": "allow",
      "snip git branch -v*": "allow",
      "snip git branch --show-current": "allow",
      "snip git branch --merged *": "allow",
      "snip git branch --no-merged *": "allow",
      "snip git worktree list*": "allow",
      "snip git remote": "allow",
      "snip git remote -v": "allow",
      "snip git ls-remote *": "allow",
      "snip git merge-base *": "allow",
      "snip git rev-parse *": "allow",
      "snip git rev-list *": "allow",
      "snip git for-each-ref *": "allow",
      "snip git ls-files *": "allow",
      "snip git config --get*": "allow",

      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh pr checks*": "allow",
      "gh pr diff*": "allow",
      "gh pr status*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh repo list*": "allow",
      "gh repo view*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh auth status*": "allow",
      "gh release list*": "allow",
      "gh release view*": "allow",
      "gh search *": "allow",
      "gh workflow list*": "allow",
      "gh workflow view*": "allow",
      "gh label list*": "allow",

      "snip gh pr list*": "allow",
      "snip gh pr view*": "allow",
      "snip gh pr checks*": "allow",
      "snip gh pr diff*": "allow",
      "snip gh pr status*": "allow",
      "snip gh issue list*": "allow",
      "snip gh issue view*": "allow",
      "snip gh repo list*": "allow",
      "snip gh repo view*": "allow",
      "snip gh run list*": "allow",
      "snip gh run view*": "allow",
      "snip gh auth status*": "allow",
      "snip gh release list*": "allow",
      "snip gh release view*": "allow",
      "snip gh search *": "allow",
      "snip gh workflow list*": "allow",
      "snip gh workflow view*": "allow",
      "snip gh label list*": "allow",

      "task --list*": "allow",
      "task clean*": "allow",
      "task test*": "allow",
      "task build*": "allow",
      "go version*": "allow",
      "helmfile * template *": "allow",

      "tofu init": "allow",
      "tofu init -upgrade": "allow",
      "tofu init -input=false": "allow",
      "tofu plan": "allow",
      "tofu plan -input=false": "allow",
      "tofu plan -refresh=false": "allow",

      "tofu apply": "ask",
      "tofu apply *": "ask",
      "tofu destroy": "ask",
      "tofu destroy *": "ask",
      "tofu import": "ask",
      "tofu import *": "ask",
      "tofu state": "ask",
      "tofu state *": "ask",
      "tofu workspace": "ask",
      "tofu workspace *": "ask",
      "tofu force-unlock": "ask",
      "tofu force-unlock *": "ask",
      "tofu init *-backend-config*": "ask",
      "tofu init *--backend-config*": "ask",
      "tofu init *-reconfigure*": "ask",
      "tofu init *--reconfigure*": "ask",
      "tofu init *-migrate-state*": "ask",
      "tofu init *--migrate-state*": "ask",
      "tofu plan *-generate-config-out*": "ask",

      "snip task --list*": "allow",
      "snip task clean*": "allow",
      "snip task test*": "allow",
      "snip task build*": "allow",
      "snip go version*": "allow",
      "snip helmfile * template *": "allow",

      "snip tofu init": "allow",
      "snip tofu init -upgrade": "allow",
      "snip tofu init -input=false": "allow",
      "snip tofu plan": "allow",
      "snip tofu plan -input=false": "allow",
      "snip tofu plan -refresh=false": "allow",

      "snip tofu apply": "ask",
      "snip tofu apply *": "ask",
      "snip tofu destroy": "ask",
      "snip tofu destroy *": "ask",
      "snip tofu import": "ask",
      "snip tofu import *": "ask",
      "snip tofu state": "ask",
      "snip tofu state *": "ask",
      "snip tofu workspace": "ask",
      "snip tofu workspace *": "ask",
      "snip tofu force-unlock": "ask",
      "snip tofu force-unlock *": "ask",
      "snip tofu init *-backend-config*": "ask",
      "snip tofu init *--backend-config*": "ask",
      "snip tofu init *-reconfigure*": "ask",
      "snip tofu init *--reconfigure*": "ask",
      "snip tofu init *-migrate-state*": "ask",
      "snip tofu init *--migrate-state*": "ask",
      "snip tofu plan *-generate-config-out*": "ask",

    },
  },
}
